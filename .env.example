# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=https://taskcraft.aakasa.dev

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_API_URL=https://api-m.paypal.com
PAYPAL_WEBHOOK_ID=your-webhook-id

# PayPal Plan IDs (baked into JS bundle for subscription buttons)
NEXT_PUBLIC_PAYPAL_PLAN_ID_SOLO_MONTHLY=
NEXT_PUBLIC_PAYPAL_PLAN_ID_SOLO_YEARLY=
NEXT_PUBLIC_PAYPAL_PLAN_ID_TEAM_MONTHLY=
NEXT_PUBLIC_PAYPAL_PLAN_ID_TEAM_YEARLY=

# Server-side plan IDs (for webhook verification)
PAYPAL_PLAN_ID_SOLO_MONTHLY=
PAYPAL_PLAN_ID_SOLO_YEARLY=
PAYPAL_PLAN_ID_TEAM_MONTHLY=
PAYPAL_PLAN_ID_TEAM_YEARLY=

# OpenAI (required for AI features)
OPENAI_API_KEY=sk-...

# Email — uncomment to enable real invitation/notification emails
# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@taskcraft.aakasa.dev

# Admin
ADMIN_EMAILS=your@email.com
CRON_SECRET=your-cron-secret
