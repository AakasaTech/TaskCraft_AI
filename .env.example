# ============================================================
# TaskCraft AI — Environment Variables
# ============================================================

# ── Neon Database ───────────────────────────────────────────
# Connection string from Neon Console (with ?sslmode=require)
DATABASE_URL="postgresql://user:password@ep-xyz-123456.us-east-2.aws.neon.tech/taskcraft?sslmode=require"

# ── NextAuth v5 (Auth.js) ───────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-32-byte-base64-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional for social login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Storage (AWS S3 or Cloudflare R2) ────────────────────────
# If not configured, uploads will use local fallback in /public/uploads
STORAGE_PROVIDER="s3"
AWS_S3_REGION="us-east-1"
AWS_S3_BUCKET="taskcraft-storage"
AWS_S3_ACCESS_KEY_ID=""
AWS_S3_SECRET_ACCESS_KEY=""
# For Cloudflare R2, specify endpoint URL:
# AWS_S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# STORAGE_PUBLIC_URL="https://pub-<hash>.r2.dev"

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── PayPal ───────────────────────────────────────────────────
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_API_URL="https://api-m.paypal.com"
PAYPAL_WEBHOOK_ID="your-webhook-id"

# PayPal Plan IDs (client-side)
NEXT_PUBLIC_PAYPAL_PLAN_ID_SOLO_MONTHLY=""
NEXT_PUBLIC_PAYPAL_PLAN_ID_SOLO_YEARLY=""
NEXT_PUBLIC_PAYPAL_PLAN_ID_TEAM_MONTHLY=""
NEXT_PUBLIC_PAYPAL_PLAN_ID_TEAM_YEARLY=""

# PayPal Plan IDs (server-side webhook verification)
PAYPAL_PLAN_ID_SOLO_MONTHLY=""
PAYPAL_PLAN_ID_SOLO_YEARLY=""
PAYPAL_PLAN_ID_TEAM_MONTHLY=""
PAYPAL_PLAN_ID_TEAM_YEARLY=""

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ── Email (Resend) ───────────────────────────────────────────
# RESEND_API_KEY="re_..."
# EMAIL_FROM="noreply@taskcraft.aakasa.dev"

# ── Admin & Cron ─────────────────────────────────────────────
ADMIN_EMAILS="admin@example.com"
CRON_SECRET="your-cron-secret"
